{
  "name": "zhuxing-harness",
  "version": "0.3.8",
  "private": true,
  "description": "筑星 Harness —— 可随意接入插件的 Agent Harness 体系",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "harness": "packages/cli/dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "vitest run tests",
    "typecheck": "pnpm -r typecheck",
    "harness": "node packages/cli/dist/cli.js",
    "bench": "node scripts/bench.mjs",
    "bundle": "node scripts/bundle-cli.mjs",
    "check": "pnpm -r build && pnpm typecheck && pnpm -r test && pnpm test:e2e"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.0",
    "@zhuxing/harness-agent": "workspace:^",
    "@zhuxing/harness-cli": "workspace:^",
    "@zhuxing/harness-config": "workspace:^",
    "@zhuxing/harness-kernel": "workspace:^",
    "@zhuxing/harness-knowledge": "workspace:^",
    "@zhuxing/harness-llm": "workspace:^",
    "@zhuxing/harness-memory": "workspace:^",
    "@zhuxing/harness-model-router": "workspace:^",
    "@zhuxing/harness-sandbox": "workspace:^",
    "@zhuxing/harness-session": "workspace:^",
    "@zhuxing/harness-skills": "workspace:^",
    "@zhuxing/harness-specs": "workspace:^",
    "@zhuxing/harness-tools": "workspace:^",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
