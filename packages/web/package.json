{
  "name": "@zhuxing/harness-web",
  "version": "0.1.0",
  "description": "筑星 Harness Web UI：对话 / 工作 / 交付一整套流程（HTTP + SSE 后端 + React 前端）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": ["dist", "dist-ui"],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "harness-web": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zhuxing/harness-agent": "workspace:^0.1.0",
    "@zhuxing/harness-bundle": "workspace:^0.1.0",
    "@zhuxing/harness-kernel": "workspace:^0.1.0",
    "@zhuxing/harness-llm": "workspace:^0.1.0",
    "@zhuxing/harness-sandbox": "workspace:^0.1.0",
    "@zhuxing/harness-session": "workspace:^0.1.0",
    "@zhuxing/harness-tools": "workspace:^0.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "@types/node": "^22.10.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
