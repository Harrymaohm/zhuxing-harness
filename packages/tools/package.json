{
  "name": "@zhuxing/harness-tools",
  "version": "0.1.0",
  "description": "筑星 Harness 工具：工具注册表 + 执行管道（拦截/沙箱/超时/结果规范化）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zhuxing/harness-kernel": "workspace:^0.1.0",
    "@zhuxing/harness-llm": "workspace:^0.1.0",
    "@zhuxing/harness-sandbox": "workspace:^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
