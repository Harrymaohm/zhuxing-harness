{
  "name": "@zhuxing/harness-cli",
  "version": "0.4.0",
  "description": "筑星 Harness CLI：run / validate / create-plugin / list",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "harness": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/cli.js": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@zhuxing/harness-agent": "workspace:^",
    "@zhuxing/harness-bundle": "workspace:^",
    "@zhuxing/harness-config": "workspace:^",
    "@zhuxing/harness-kernel": "workspace:^",
    "@zhuxing/harness-llm": "workspace:^",
    "@zhuxing/harness-memory": "workspace:^",
    "@zhuxing/harness-model-router": "workspace:^",
    "@zhuxing/harness-sandbox": "workspace:^",
    "@zhuxing/harness-session": "workspace:^",
    "@zhuxing/harness-skills": "workspace:^",
    "@zhuxing/harness-tools": "workspace:^",
    "@zhuxing/harness-web": "workspace:^",
    "adm-zip": "^0.6.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
