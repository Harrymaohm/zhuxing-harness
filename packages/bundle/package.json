{
  "name": "@zhuxing/harness-bundle",
  "version": "0.4.0",
  "description": "筑星 Harness 基础 bundle：以插件形态组合沙箱/会话/工具/模型/循环（cli 与 web 共用）",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@zhuxing/harness-agent": "workspace:^",
    "@zhuxing/harness-kernel": "workspace:^",
    "@zhuxing/harness-knowledge": "workspace:^",
    "@zhuxing/harness-llm": "workspace:^",
    "@zhuxing/harness-memory": "workspace:^",
    "@zhuxing/harness-model-router": "workspace:^",
    "@zhuxing/harness-sandbox": "workspace:^",
    "@zhuxing/harness-session": "workspace:^",
    "@zhuxing/harness-skills": "workspace:^",
    "@zhuxing/harness-tools": "workspace:^",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
